{
  "expo": {
    "scheme": "skia",
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "hidden": true,
          "style": "light",
          "enforceContrast": false
        }
      ],
      "./plugins/with-transient-navigation-bar",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7463440033205599~9693590947",
          "iosAppId": "ca-app-pub-7463440033205599~9698715982"
        }
      ]
    ],
    "androidNavigationBar": {
      "visible": "sticky-immersive",
      "barStyle": "light-content"
    },
    "android": {
      "package": "com.morningcoffeelabs.furyo",
      "icon": "./public/fury-icon.png"
    },
    "icon": "./public/fury-icon.png",
    "name": "furyo",
    "slug": "furyo",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0962f1fd-7c6f-406e-b540-776e5178c4cb"
      }
    },
    "ios": {
      "bundleIdentifier": "com.morningcoffeelabs.furyo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
